# pebble-webhook start values (/etc/pebble-webhook/env). install.sh writes this file on the first install.
# All other settings are entered in the web app: setup wizard on first start, later Status → Einstellungen.
LISTEN=0.0.0.0:8080
DATA_DIR=/var/lib/pebble-webhook
AUDIO_DIR=/var/lib/pebble-webhook/audio
